  "lorebook": [
    {
      "id": "station_hidden_cellar",
      "keys": [
        "军统天津站",
        "地下通道"
      ],
      "secondary_keys": [],
      "content": "天津站原址为前清某贝勒的别院，改建时发现书房下方有逃生密道，如今被站长吴敬中用作私人保险库，藏匿财产账册与秘密裁决令，除他之外无人知晓。暗道出口设在隔壁裁缝铺后院的假山水池之下。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 85,
      "scan_depth": 3,
      "comment": "地点秘辛",
      "related_entries": []
    },
    {
      "id": "haimen_smuggler_net",
      "keys": [
        "海门码头仓库区",
        "走私"
      ],
      "secondary_keys": [
        "海面鬼市"
      ],
      "content": "码头工人中流传“海面鬼市”的说法：每周三黎明前，驳船会载着禁运物资在灯塔背阴处交易。陆桥山背着站长利用仓库区做私货中转，余则成曾借查缉走私名义从这里递出过一份画着“茶叶”符号的密写情报。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 85,
      "scan_depth": 3,
      "comment": "码头暗网",
      "related_entries": []
    },
    {
      "id": "cpc_tianjin_network_detail",
      "keys": [
        "中共天津地下情报站",
        "窑台"
      ],
      "secondary_keys": [
        "黄记小馆",
        "交通线"
      ],
      "content": "地下情报站采用单线联系与假身份制度，交通员老黄只认暗号不认脸，传递物通常是密写药水、火柴盒或者画有“茶叶”符号的包装纸。紧急情况下，可启用石灰镇洋房二楼窗口的花盆暗号：君子兰搬离窗台表示处境安全，换成仙人掌则警告接头取消。\n“窑台”在码头工人、中学教员和报馆排字工中都有关系网，但保持极端审慎，每扩大一点外围就先预备好疏散路线。余则成提供的情报通常经老黄交给骑自行车赶来的交通员，再渡海河送抵解放区通讯站，全程不超过四小时。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 85,
      "scan_depth": 3,
      "comment": "地下党运作机制",
      "related_entries": [
        "deep_sea_trust",
        "hidden_front_morale",
        "haimen_smuggler_net"
      ]
    },
    {
      "id": "qib_indirect_control",
      "keys": [
        "海河青帮分舵",
        "海面鬼市"
      ],
      "secondary_keys": [
        "走私",
        "陆桥山"
      ],
      "content": "海河帮的账簿比天津站的机要档案还细密，每周三黎明前的“鬼市”交易记录一式三份，一份压在水底水泥管里，一份藏在南市茶馆的房梁上，第三份则由账房锁在铁箱里。这股势力实际上通过脚行控制着码头的货物进出，保密局若想全盘掌控码头情报流，非借青帮之手不可。\n但帮会内部也非铁板一块：舵主忌惮马奎的杀伐气，更倾向与陆桥山做长久买卖。余则成曾听陆桥山酒后漏言，说自己手里压着一份鬼市走私清单，关键时刻能要挟舵主交出整个码头的运转密码。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 85,
      "scan_depth": 3,
      "comment": "青帮走私内情",
      "related_entries": [
        "haimen_smuggler_net",
        "station_internal_faction"
      ]
    },
    {
      "id": "余则成",
      "keys": [
        "余则成",
        "峨眉峰"
      ],
      "secondary_keys": [],
      "content": "余则成原为重庆军统外勤，1945年奉命赴南京刺杀汉奸李海丰。期间受恋人左蓝及上司吕宗方影响，被中共策反，代号“峨眉峰”。返回重庆获嘉奖后，被派往军统天津站（后改保密局）潜伏，成为插入国民党情报心脏的一枚铆钉。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "主角的双重身份与潜伏代号由来",
      "related_entries": []
    },
    {
      "id": "翠平",
      "keys": [
        "翠平",
        "陈桃花"
      ],
      "secondary_keys": [],
      "content": "翠平原名陈桃花，曾任太行山区游击队长，脾气火爆直率。因接替出事的妹妹，被党组织紧急派往天津冒充余则成的夫人。起初对潜伏生活一窍不通，屡闹笑话，后在余则成和吴太太的调教下逐渐成熟，与余则成产生真情并结为夫妻，育有一女。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "冒牌夫人兼游击队长的成长与牺牲",
      "related_entries": []
    },
    {
      "id": "李涯",
      "keys": [
        "李涯",
        "佛龛"
      ],
      "secondary_keys": [],
      "content": "李涯是军统精心培养的特务，曾化名冯剑潜伏延安第二保小任教，代号“佛龛”，潜伏长达数年。调回天津站后接替马奎出任行动队队长，心思缜密、执着狠辣，多次追查余则成夫妇真实身份，是余则成在站内最危险的对手。最终被地下党廖三民抱住坠楼同归于尽。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "来自延安的国民党潜伏特务，余则成的死敌",
      "related_entries": []
    },
    {
      "id": "左蓝",
      "keys": [
        "左蓝",
        "军调代表"
      ],
      "secondary_keys": [],
      "content": "左蓝是中共地下党员、余则成的恋人，美丽英勇，有文化有追求。她引导余则成走上革命道路，后以共产党军调代表身份公开出现在天津，与余则成以敌对阵营身份相见却只能演戏。被马奎杀害时仍不知余则成与翠平是假夫妻，其死深深震撼了余则成。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "余则成的革命引路人与永远的爱人",
      "related_entries": []
    },
    {
      "id": "吕宗方",
      "keys": [
        "吕宗方",
        "刺杀李海丰"
      ],
      "secondary_keys": [],
      "content": "吕宗方表面是军统情报处余则成的上司，实为中共地下党员。1945年奉派与余则成赴南京刺杀叛徒李海丰，行动前夕被军统下令由马奎枪杀。其遗志由左蓝完成，成功策反余则成。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "双重身份的上司与领路人",
      "related_entries": []
    },
    {
      "id": "李海丰",
      "keys": [
        "李海丰",
        "锄奸"
      ],
      "secondary_keys": [],
      "content": "李海丰原为军统密码专家，1945年抗战胜利前夕叛投南京汪伪政权，激怒军统高层。余则成化名劳文池潜入伪政保总署电讯处，在吕宗方被杀后独自完成刺杀，此举使余则成成为军统功臣，也导致他后来遭受追杀、被共产党所救的转折。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "汉奸叛徒，促成余则成命运转折的刺杀目标",
      "related_entries": []
    },
    {
      "id": "吴敬中",
      "keys": [
        "吴敬中",
        "密账"
      ],
      "secondary_keys": [],
      "content": "天津站站长吴敬中老谋深算，以青浦特训班师生关系将余则成调至身边，实则利用其为自己疯狂敛财。他受贿、敲诈汉奸穆连成，将秘密账册和金条藏于站内密道或私人保险库，并以副站长之位为饵，坐看马奎、陆桥山、李涯等人内斗，稳固自身地位。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "站长的敛财手段与办公室政治操控",
      "related_entries": []
    },
    {
      "id": "陆桥山",
      "keys": [
        "陆桥山",
        "走私"
      ],
      "secondary_keys": [],
      "content": "陆桥山任保密局天津站情报处长，热衷办公室政治，主业是排挤竞争者以谋取副站长之位。暗中与海河青帮勾结，利用码头走私获利，并试图以查缉之名控制帮会。在陷害马奎后，自身亦被李涯设计，调离天津站，后以国府巡查员身份回来报复，最终死在翠平枪下。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "情报处长的走私网络与内部倾轧",
      "related_entries": []
    },
    {
      "id": "马奎",
      "keys": [
        "马奎",
        "行动队长"
      ],
      "secondary_keys": [],
      "content": "马奎是保密局天津站行动队队长，作风凶悍，曾执行枪杀吕宗方的密令。他怀疑余则成身份，安放眼线暗中调查，并借打击青帮立威。在内部斗争中被陆桥山陷害为共产党的“峨眉峰”，最终死于非命，其妻子亦受到牵连。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "鲁莽的怀疑者与办公室政治的牺牲品",
      "related_entries": []
    },
    {
      "id": "秋掌柜",
      "keys": [
        "秋掌柜",
        "药铺接头"
      ],
      "secondary_keys": [],
      "content": "秋掌柜是中共天津地下情报站的重要联络人，公开身份为药铺掌柜，负责为余则成传达指示、安排翠平到来等事宜。后被保密局逮捕，受尽酷刑仍严守秘密，未出卖同志，展现了地下党的坚贞。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "宁死不屈的药店联络员",
      "related_entries": []
    },
    {
      "id": "谢若林",
      "keys": [
        "谢若林",
        "情报掮客"
      ],
      "secondary_keys": [],
      "content": "谢若林是就职于党通局的情报贩子，唯利是图，后娶穆晚秋为妻。他与李涯合作，收买叛徒、倒卖情报，试图挖出中共潜伏特工，直接威胁余则成安全。其名言‘嘴上全是主义，心里全是生意’尽显投机本质。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "金钱至上的情报掮客与婚姻交易",
      "related_entries": []
    },
    {
      "id": "穆连成",
      "keys": [
        "穆连成",
        "汉奸"
      ],
      "secondary_keys": [],
      "content": "穆连成是抗战期间与日伪过从甚密的大汉奸。抗战胜利后为求自保，企图通过向吴敬中行贿（献出酒厂）和将其侄女晚秋嫁给余则成来保全财产，最终携带大量资产与日本情妇逃往日本。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "试图用金钱和联姻脱罪的旧汉奸",
      "related_entries": []
    },
    {
      "id": "廖三民",
      "keys": [
        "廖三民",
        "李涯之死"
      ],
      "secondary_keys": [],
      "content": "廖三民是中共隐蔽在天津执法队的地下党员，身份暴露时，为掩护重要情报和战友，毅然抱住死敌李涯从楼上跳下，同归于尽。这一壮举除掉了余则成最大的内部威胁，也付出了生命的代价。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "与敌偕亡的潜伏英雄",
      "related_entries": []
    },
    {
      "id": "副站长",
      "keys": [
        "副站长",
        "办公室政治"
      ],
      "secondary_keys": [],
      "content": "天津站内部吴敬中故意悬置副站长职位，使之成为部下争斗的目标。马奎、陆桥山、李涯为此互相陷害倾轧，余则成虽不主动参与，最终却被吴敬中提拔为副站长，继续充当其敛财的白手套，同时获得了更高的情报密级和更大的潜伏风险。",
      "position": "after_world",
      "enabled": true,
      "constant": false,
      "priority": 100,
      "scan_depth": 3,
      "comment": "天津站权力斗争的焦点与余则成的晋升",
      "related_entries": []
    }
  ],
