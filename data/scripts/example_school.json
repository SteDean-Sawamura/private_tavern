{
  "script_id": "example_school",
  "script_name": "光明小学",
  "version": "1.0",
  "start_time": "2025-09-01T07:00:00",
  "world_background": "现实世界观，S市，光明小学，幸福小区。你是小明，刚随父母从别的城市转学到这里，准备进入四年级二班。这个示例模板已经预置了固定开局选项、随机项、角色属性、持续状态、循环事件和一次性剧情节点，新手作者可以通过修改这些内容快速体验各种概念。",
  "settings": {
    "dice_check": {
      "default_enabled": true,
      "player_can_toggle": true
    },
    "fixed_opening": {
      "default_enabled": true,
      "player_can_toggle": true
    },
    "allow_player_control_switch": false,
    "vector_memory_enabled": true
  },
  "opening": {
    "text": "今天是开学的第一天，你背着书包站在光明小学的校门口。\n阳光洒在操场上，到处是欢声笑语。你感到既兴奋又有些紧张。\n你的新生活即将在这里展开，你会遇到什么样的老师和同学呢？",
    "choices": [
      {
        "id": "open_0",
        "text": "深呼吸一口气，大步走进校园，寻找四年级二班的教室。",
        "result": {
          "type": "deterministic",
          "description": "你顺利找到了教室，并选了一个靠窗的位置坐下。",
          "state_changes": [
            {
              "target": "player.mood",
              "op": "add",
              "value": 5
            }
          ]
        }
      },
      {
        "id": "open_1",
        "text": "在校门口观察一会儿，看看有没有看起来比较友善的同学可以搭讪。",
        "result": {
          "type": "conditional",
          "description": "你成功结识了同桌林雨。",
          "state_changes": [
            {
              "target": "player.relationships.linyu",
              "op": "add",
              "value": 5
            }
          ],
          "conditions": [
            {
              "check": "dice < 50",
              "description": "你只是礼貌地打了个招呼。",
              "state_changes": []
            }
          ]
        }
      },
      {
        "id": "open_2",
        "text": "先去布告栏看看学校的平面图，确保自己不会迷路。",
        "result": {
          "type": "conditional",
          "description": "你对学校环境有了初步了解。",
          "state_changes": [],
          "conditions": [
            {
              "check": "dice > 50",
              "description": "你对学校环境有了初步了解。",
              "state_changes": [
                {
                  "target": "player.intelligence",
                  "op": "add",
                  "value": 2
                }
              ]
            }
          ]
        }
      }
    ]
  },
